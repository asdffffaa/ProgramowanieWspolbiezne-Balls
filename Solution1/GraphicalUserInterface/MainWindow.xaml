<Window x:Class="TP.ConcurrentProgramming.PresentationView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pm="clr-namespace:TP.ConcurrentProgramming.PresentationModel.Models;assembly=TP.ConcurrentProgramming.PresentationModel"
        mc:Ignorable="d"
        Title="Billiard Table"
        Height="600"
        Width="1000">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Balls count:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Width="60"
                     Text="{Binding BallsCount, UpdateSourceTrigger=LostFocus}"
                     Margin="0,0,20,0"/>

            <Button Content="Create"
                    Width="100"
                    Command="{Binding CreateBallsCommand}"
                    Margin="0,0,10,0"/>

            <Button Content="Start"
                    Width="100"
                    Command="{Binding StartCommand}"
                    Margin="0,0,10,0"/>

            <Button Content="Stop"
                    Width="100"
                    Command="{Binding StopCommand}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Width="{Binding ViewBoardWidth}"
                Height="{Binding ViewBoardHeight}"
                BorderBrush="Black"
                BorderThickness="2"
                Background="LightGray"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <ItemsControl ItemsSource="{Binding Board.Balls}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pm:BallPresentationModel}">
                        <Ellipse Width="{Binding Diameter}"
                                 Height="{Binding Diameter}"
                                 Fill="CornflowerBlue"
                                 Stroke="Black"
                                 StrokeThickness="1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>